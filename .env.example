# Copy to .env.local for local development. Never commit real values.
# Every variable is optional locally: with none set, the app runs open as the owner,
# without a database (progress stays in the browser) — the quickest way to look around.

# Server-only database URL (Postgres over Neon's HTTP driver). On Vercel the Neon
# integration injects it. Without it there are no accounts beyond the owner and no sync.
DATABASE_URL=

# Owner sign-in. SITE_PASSWORD_SHA256 is the SHA-256 hex of the owner's password (the
# first sign-in moves it to scrypt in the database); AUTH_COOKIE_SECRET signs session
# cookies, 32+ random characters (e.g. `openssl rand -hex 32`). Set both or neither:
# setting either one turns the gate on, and production refuses to run without both.
SITE_PASSWORD_SHA256=
AUTH_COOKIE_SECRET=

# Owner username (default: anil). Lower-case letters, digits, dot, underscore, hyphen.
OWNER_USERNAME=

# Public launch switch. Unset (the default) = the site behaves as a private library:
# everything but /login needs an account and nobody can sign up. 1 = the AI series,
# the home page, sign-up and the privacy page open to everyone. Requires a redeploy.
PUBLIC_LAUNCH=

# Canonical origin for links, sitemap and previews, e.g. https://example.org.
# Unset: Vercel's production domain, or http://localhost:3000 outside Vercel.
SITE_URL=

# Vercel preview builds skip database migrations unless this is 1. Set it only when
# previews have their own database (for example a Neon branch per preview).
MIGRATE_ON_PREVIEW=
